{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "types": ["node"]
  },
  "include": ["playwright.config.ts", "fixtures/**/*.ts", "pages/**/*.ts", "utils/**/*.ts", "tests/**/*.ts", "reporters/**/*.ts"]
}
