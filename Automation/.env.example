# Скопіюйте цей файл у .env і змініть значення за потреби.

# Сайт, на якому запускаються тести:
#   https://alpha.wowcube.dev   — за замовчуванням (гілка develop, з якою звірені тести)
#   http://localhost:5173       — сайт, піднятий локально (TARGET=alpha ... npx vite dev)
#   https://wowcube.com         — prod, обережно (див. README)
BASE_URL=https://alpha.wowcube.dev

# Варіант A/B-тесту головної: A, B або C (тести фіксують його, щоб результат був стабільним)
HOMEPAGE_VARIANT=A

# true — блокувати аналітику, чат Zendesk, Customer.io і Convert (рекомендовано)
BLOCK_THIRD_PARTY=true

# Примусова країна відвідувача для всіх тестів, наприклад US. Порожньо — країна за IP.
COUNTRY_OVERRIDE=

# Регулярний вираз для адреси Shopify checkout
CHECKOUT_URL_PATTERN=myshopify\.com|shop\.wowcube\.com|checkout\.shopify\.com

# Промо-банер над хедером (з адмінки) у тестах схований, крім SM-01 і тестів самого банера.
# false — показувати реальний банер у всіх тестах.
HIDE_PROMO_BANNER=true
